# Dependencies (installed inside the image)
node_modules
vendor

# Build artifacts (produced inside the image)
public/build
public/hot
bootstrap/ssr

# Wayfinder-generated files (regenerated in the vendor stage)
resources/js/actions
resources/js/routes
resources/js/wayfinder

# Runtime caches may contain credentials or paths from another deployment.
bootstrap/cache/*
!bootstrap/cache/.gitignore

# Local runtime / secrets / VCS
.git
.github
.env*
auth.json
**/*.sqlite*
storage/*.key
storage/app/*
!storage/app/.gitignore
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
public/storage

# Octane frankenphp binary (image provides it)
/frankenphp

# Docs & tooling not needed in the image
docs
.agents
.codex
.cursor
.claude
